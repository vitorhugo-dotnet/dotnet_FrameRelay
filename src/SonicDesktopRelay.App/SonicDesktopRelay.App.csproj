<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The App is the composition root and the only place that touches Media.Windows.
         MSBuild cannot reference a net10.0-windows project from a net10.0 one, and this
         executable is Windows-only by design (WGC capture, DPAPI credential store). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>SonicDesktopRelay</AssemblyTitle>
    <Description>Share a Windows screen with other Windows machines over SonicRelay.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SonicDesktopRelay.ApiClient\SonicDesktopRelay.ApiClient.csproj" />
    <ProjectReference Include="..\SonicDesktopRelay.Core\SonicDesktopRelay.Core.csproj" />
    <ProjectReference Include="..\SonicDesktopRelay.Media.Windows\SonicDesktopRelay.Media.Windows.csproj" />
    <ProjectReference Include="..\SonicDesktopRelay.Rtc\SonicDesktopRelay.Rtc.csproj" />
    <ProjectReference Include="..\SonicDesktopRelay.Presentation\SonicDesktopRelay.Presentation.csproj" />
    <ProjectReference Include="..\SonicDesktopRelay.Signaling\SonicDesktopRelay.Signaling.csproj" />
  </ItemGroup>

</Project>
