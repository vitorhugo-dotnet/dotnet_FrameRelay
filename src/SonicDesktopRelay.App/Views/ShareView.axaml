<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SonicDesktopRelay.App"
             xmlns:media="clr-namespace:SonicDesktopRelay.Media;assembly=SonicDesktopRelay.Media"
             x:Class="SonicDesktopRelay.App.Views.ShareView"
             x:DataType="app:Shell">
    <StackPanel Margin="{StaticResource PagePadding}" Spacing="{StaticResource SpaceMd}">
        <TextBlock Text="Share"
                   FontSize="{StaticResource FontSizeLg}"
                   Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding LaunchNotice}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <StackPanel Spacing="{StaticResource SpaceXs}">
            <TextBlock Text="Monitor"
                       FontSize="{StaticResource FontSizeSm}"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox Name="MonitorPicker"
                      Width="360"
                      ItemsSource="{Binding Monitors}"
                      SelectedItem="{Binding SelectedMonitor}"
                      IsEnabled="{Binding ViewModel.CanShare}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="media:MonitorInfo">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
            <StackPanel Spacing="{StaticResource SpaceXs}">
                <TextBlock Text="Quality"
                           FontSize="{StaticResource FontSizeSm}"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox Width="170"
                          ItemsSource="{Binding ShareQualities}"
                          SelectedItem="{Binding SelectedShareQuality}"
                          IsEnabled="{Binding ViewModel.CanShare}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="app:ShareQualityOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SpaceXs}">
                <TextBlock Text="Frame rate"
                           FontSize="{StaticResource FontSizeSm}"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox Width="170"
                          ItemsSource="{Binding ShareFrameRates}"
                          SelectedItem="{Binding SelectedShareFrameRate}"
                          IsEnabled="{Binding ViewModel.CanShare}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="app:ShareFrameRateOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <Border Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="{StaticResource PagePadding}">
            <StackPanel Spacing="{StaticResource SpaceSm}">
                <TextBlock Text="Session code"
                           FontSize="{StaticResource FontSizeSm}"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <SelectableTextBlock Name="CodeText"
                                     Text="{Binding ViewModel.Code, TargetNullValue=------}"
                                     FontSize="{StaticResource FontSizeCode}"
                                     FontFamily="Consolas, monospace"
                                     Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Content="Copy code"
                        IsEnabled="{Binding ViewModel.Code, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Click="OnCopy" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding ViewModel.StatusText}"
                   FontSize="{StaticResource FontSizeMd}"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
            <Button Content="Start sharing"
                    IsEnabled="{Binding ViewModel.CanShare}"
                    Click="OnShare" />
            <Button Content="Stop sharing"
                    IsEnabled="{Binding ViewModel.CanStop}"
                    Click="OnStop" />
        </StackPanel>
    </StackPanel>
</UserControl>
