<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SonicDesktopRelay.App"
             x:Class="SonicDesktopRelay.App.Views.DiagnosticsView"
             x:DataType="app:Shell"
             Container.Name="diagnosticsPage" Container.Sizing="Width">
    <UserControl.Styles>
        <Style Selector="Border.summaryCard">
            <Setter Property="Width" Value="240" />
        </Style>
        <ContainerQuery Name="diagnosticsPage" Query="max-width:620">
            <Style Selector="Border.summaryCard">
                <Setter Property="Width" Value="220" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" Spacing="{StaticResource SpaceLg}">
            <StackPanel Spacing="{StaticResource SpaceXs}">
                <TextBlock Text="Diagnostics" FontSize="{StaticResource FontSizeXl}"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Session, signaling, and media diagnostics from this client."
                           TextWrapping="Wrap" FontSize="{StaticResource FontSizeMd}"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <WrapPanel Orientation="Horizontal">
                <Border Classes="card summaryCard" Margin="0,0,16,16">
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="Session" FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ViewModel.Snapshot.Phase}"
                                   FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Current session phase" FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Classes="card summaryCard" Margin="0,0,16,16">
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="Signaling" FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ViewModel.Snapshot.Signaling}"
                                   FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Current socket state" FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Classes="card summaryCard" Margin="0,0,16,16">
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="Viewers" FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ViewModel.DiagnosticsViewerCount}"
                                   FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Count available while sharing" FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Classes="card">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="Media status" FontSize="{StaticResource FontSizeLg}"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <SelectableTextBlock Text="{Binding MediaStatusText}" TextWrapping="Wrap"
                                         FontFamily="Consolas, monospace" FontSize="{StaticResource FontSizeSm}"
                                         Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Classes="card unavailable" IsEnabled="False" Focusable="False">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="Connection health metrics unavailable"
                               FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Width="120" Margin="0,0,16,8">
                            <TextBlock Text="Latency" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="---" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,16,8">
                            <TextBlock Text="Bitrate" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="---" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,16,8">
                            <TextBlock Text="Packet loss" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="---" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,16,8">
                            <TextBlock Text="Jitter" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="---" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="{StaticResource SpaceMd}">
                <TextBlock Text="Diagnostic logs" FontSize="{StaticResource FontSizeLg}"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <Border Classes="card unavailable" IsEnabled="False" Focusable="False">
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="Filtering, search, copy, and export unavailable"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="Filter events" IsEnabled="False" Margin="0,0,8,8" />
                            <Button Content="Search" IsEnabled="False" Margin="0,0,8,8" />
                            <Button Content="Copy diagnostics" IsEnabled="False" Margin="0,0,8,8" />
                            <Button Content="Export logs" IsEnabled="False" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="Session snapshots" FontSize="{StaticResource FontSizeMd}"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Published session snapshots, newest first."
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Diagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <SelectableTextBlock Text="{Binding}" Margin="0,0,0,6"
                                                             FontFamily="Consolas, monospace"
                                                             FontSize="{StaticResource FontSizeSm}"
                                                             Foreground="{StaticResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="Signaling" FontSize="{StaticResource FontSizeMd}"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="RX/TX envelope metadata only, newest first. Payloads, SDP, and ICE candidate contents are never recorded."
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SignalingDiagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <SelectableTextBlock Text="{Binding}" Margin="0,0,0,6"
                                                             FontFamily="Consolas, monospace"
                                                             FontSize="{StaticResource FontSizeSm}"
                                                             Foreground="{StaticResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="Viewer WebRTC" FontSize="{StaticResource FontSizeMd}"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Offer/answer stages and peer-state transitions, newest first. SDP, ICE candidate contents, and credentials are never stored."
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding WebRtcDiagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <SelectableTextBlock Text="{Binding}" Margin="0,0,0,6"
                                                             FontFamily="Consolas, monospace"
                                                             FontSize="{StaticResource FontSizeSm}"
                                                             Foreground="{StaticResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="{StaticResource SpaceXs}">
                    <TextBlock Text="Persistent log directory" FontSize="{StaticResource FontSizeMd}"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <SelectableTextBlock Text="{Binding LogDirectory}" TextWrapping="Wrap"
                                         FontFamily="Consolas, monospace" FontSize="{StaticResource FontSizeSm}"
                                         Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
