<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SonicDesktopRelay.App"
             xmlns:controls="clr-namespace:SonicDesktopRelay.App.Controls"
             x:Class="SonicDesktopRelay.App.Views.WatchView"
             x:DataType="app:Shell">
    <DockPanel Name="WatchLayout" Margin="{Binding WatchPagePadding}">
        <StackPanel DockPanel.Dock="Top"
                    Spacing="{StaticResource SpaceMd}"
                    IsVisible="{Binding !IsVideoExpanded}">
            <TextBlock Text="Watch"
                       FontSize="{StaticResource FontSizeLg}"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <StackPanel Spacing="{StaticResource SpaceXs}">
                <TextBlock Text="Session code"
                           FontSize="{StaticResource FontSizeSm}"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Name="CodeBox"
                         Width="240"
                         MaxLength="6"
                         PlaceholderText="ABC123"
                         FontSize="{StaticResource FontSizeLg}"
                         FontFamily="Consolas, monospace"
                         TextChanged="OnCodeChanged" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <Button Name="WatchButton" Content="Watch" IsEnabled="False" Click="OnWatch" />
                <Button Content="Stop watching"
                        IsEnabled="{Binding ViewModel.CanStop}"
                        Click="OnStop" />
            </StackPanel>

            <TextBlock Text="{Binding ViewModel.StatusText}"
                       FontSize="{StaticResource FontSizeMd}"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <TextBlock Text="{Binding ShellError}"
                       IsVisible="{Binding ShellError, Converter={x:Static ObjectConverters.IsNotNull}}"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeSm}"
                       Foreground="{StaticResource DangerBrush}" />

            <TextBlock Text="Fit fills this window. F11 toggles fullscreen; Esc returns to normal."
                       TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeSm}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,8" />
        </StackPanel>

        <Grid PointerMoved="OnVideoPointerMoved">
            <controls:VideoSurface Name="Surface" />
            <Border Name="ViewerControls" VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch" Background="#DD151515" Padding="4" Margin="8"
                    PointerEntered="OnControlsEntered" PointerExited="OnControlsExited">
                <ScrollViewer MaxHeight="192" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Normal" Click="OnNormal" Margin="4" />
                        <Button Content="Fit to screen" Click="OnFit" Margin="4" />
                        <Button Content="Fullscreen" Click="OnFullScreen" Margin="4" />
                        <ToggleButton Content="Mute" IsChecked="{Binding ViewerMuted, Mode=TwoWay}" Margin="4" />
                        <TextBlock Text="Volume" VerticalAlignment="Center" Margin="4" />
                        <Slider Width="120" Minimum="0" Maximum="100" Margin="4"
                                Value="{Binding ViewerVolume, Mode=TwoWay}" />
                        <TextBlock Text="{Binding ViewerVolume, StringFormat='{}{0:0}%'}"
                                   Width="40" VerticalAlignment="Center" Margin="4" />
                        <Button Content="Stop" IsEnabled="{Binding ViewModel.CanStop}" Click="OnStop" Margin="4" />
                    </WrapPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
